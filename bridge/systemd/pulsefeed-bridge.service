[Unit]
Description=PulseFeed Bridge (safety-gated reverse proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pulsefeed
Group=pulsefeed
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/pulsefeed/bridge/pulsefeed-bridge.py \
    --target http://192.168.13.50 \
    --listen 127.0.0.1:8443 \
    --mode readonly \
    --trusted-proxy 127.0.0.1 \
    --audit /var/log/pulsefeed/audit.jsonl
Restart=on-failure
RestartSec=5

# The bridge needs nothing but a socket and one log file.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/pulsefeed
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=128M

[Install]
WantedBy=multi-user.target
